# LiveKit Cloud (required). Sign up at https://cloud.livekit.io.
# LIVEKIT_URL must be a Cloud URL; LiveKit Inference is a Cloud feature.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# DeepSeek official API (required for the tutor LLM).
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Redis connection (required). AOF persistence is recommended so state survives restarts.
REDIS_URL=redis://redis:6379/0

# LiveKit Inference models (Cloud). Only LIVEKIT_API_KEY is needed for STT/TTS.
# Use 'deepseek-flash' or another fast model for lower voice latency if v4-pro feels slow.
STT_MODEL=deepgram/nova-2-conversationalai
TTS_MODEL=cartesia/sonic-3.5
TTS_VOICE=ellie

# Published host ports for local docker/podman compose.
FRONTEND_PORT=3000
API_PORT=8000
REDIS_PORT=6379
