# LiveKit Cloud (required). Sign up at https://cloud.livekit.io.
# LIVEKIT_URL must be a Cloud URL; LiveKit Inference is a Cloud feature.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Logging level for the backend/agent services (optional).
# Supported values: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# LLM provider (required). Choose the provider that matches your API key/gateway.
# Supported values: openai, anthropic.
LLM_PROVIDER=openai

# Base URL for the chosen provider (required).
# - OpenAI: https://api.openai.com/v1
# - DeepSeek via OpenAI-compatible API: https://api.deepseek.com
# - Anthropic: https://api.anthropic.com
# - Any OpenAI-compatible gateway works without code changes.
LLM_BASE_URL=https://api.openai.com/v1

# API key for the chosen provider (required).
LLM_API_KEY=your_openai_api_key

# Model name (required). Plain string; swap providers/models by changing env vars.
# Examples:
#   openai:     gpt-4o-mini, gpt-4o, gpt-4.1-mini
#   deepseek:   deepseek-chat, deepseek-reasoner
#   anthropic:  claude-sonnet-4-5, claude-opus-4
LLM_MODEL=gpt-4o-mini

# Uncomment one of the following blocks to switch provider/model instead of editing code.

# --- DeepSeek example (uses the OpenAI plugin with base_url) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=deepseek-chat

# --- Anthropic example (livekit-plugins-anthropic) ---
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=your_anthropic_api_key
# LLM_MODEL=claude-sonnet-4-5

# Redis connection (required). AOF persistence is recommended so state survives restarts.
# In compose the api/agent reach redis on the internal network at redis:6379.
# For native dev with a host Redis on a different port, use e.g. redis://127.0.0.1:6380/0.
REDIS_URL=redis://redis:6379/0

# LiveKit Inference models (Cloud). Only LIVEKIT_API_KEY is needed for STT/TTS.
# Verified against livekit-agents 1.8.8's inference registry
# (livekit.agents.inference.STTModels / TTSModels).
# STT: deepgram/nova-3 is the current documented default.
# TTS: cartesia/sonic-3.5 with the Cartesia "Ellie" default voice id.
STT_MODEL=deepgram/nova-3
TTS_MODEL=cartesia/sonic-3.5
TTS_VOICE=79a125e8-cd45-4c13-8a67-188112f4dd22

# Published host ports for local docker/podman compose.
FRONTEND_PORT=3000
API_PORT=8000
